{
  "manifest_version": 3,
  "name": "Smart EMI Planner",
  "version": "1.0.2",
  "description": "Calculate loan EMIs, simulate rate hikes, moratorium interest, and optimize prepayments for Home, Car, Personal & Education loans.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Smart EMI Planner",
    "default_icon": {
      "16": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  }
}
